<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet configuration — Protons Login solution
  ─────────────────────────────────────────────
  Regras de supply chain:
  • UglyToad.PdfPig (custom build): fonte exclusiva = private-packages/ local
  • Todos os demais pacotes: nuget.org apenas
  • packageSourceMapping garante que nenhum pacote "vaza" para a fonte errada
-->
<configuration>
  <packageSources>
    <clear />
    <!-- Feed privado local: contém apenas o build custom do PdfPig -->
    <add key="protons-private" value="private-packages" />
    <!-- Feed público oficial -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <!-- UglyToad.PdfPig vem EXCLUSIVAMENTE do feed privado local -->
    <packageSource key="protons-private">
      <package pattern="UglyToad.PdfPig" />
    </packageSource>
    <!-- Todos os outros vêm de nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <packageSourceCredentials />
</configuration>
