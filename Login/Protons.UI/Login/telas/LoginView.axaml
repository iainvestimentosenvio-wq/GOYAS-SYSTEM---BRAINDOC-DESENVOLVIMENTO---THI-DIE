<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Protons.UI.Login.ViewModels"
             mc:Ignorable="d"
             x:Class="Protons.UI.Login.Views.LoginView"
             x:DataType="vm:LoginViewModel">

  <Border Background="{DynamicResource SurfaceBrush}"
          CornerRadius="16"
          Padding="32"
          Width="440"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          BorderBrush="{DynamicResource SurfaceBorderBrush}"
          BorderThickness="1"
          BoxShadow="0 4 6 0 #0D000000, 0 16 48 0 #14000000">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="6" Height="28" Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="3"/>
        <TextBlock Text="PRÓTONS" FontSize="18" FontWeight="Bold" />
      </StackPanel>

      <StackPanel Grid.Row="1" Spacing="6">
        <Image Source="avares://Protons.UI/Assets/Brand/logo_protons.png"
               MaxHeight="68"
               Stretch="Uniform"
               HorizontalAlignment="Left" />
        <TextBlock Text="Acesso ao Sistema" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Acesso seguro ao sistema" Opacity="0.7" />
      </StackPanel>

        <StackPanel Grid.Row="2" Spacing="12" Margin="0,6,0,0">
        <StackPanel Spacing="12" IsEnabled="{Binding IsNotBusy}">
          <TextBox Watermark="E-mail" Text="{Binding Email}" KeyDown="OnLoginKeyDown" MaxLength="254" AutomationProperties.Name="E-mail" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Watermark="Senha" Text="{Binding Senha}" PasswordChar="{Binding SenhaPasswordChar}" KeyDown="OnLoginKeyDown" MaxLength="256" AutomationProperties.Name="Senha" />
            <Button Grid.Column="1" Command="{Binding ToggleMostrarSenhaCommand}"
                    Background="Transparent" BorderThickness="0" Padding="12,0"
                    MinWidth="44" VerticalAlignment="Stretch"
                    AutomationProperties.Name="Mostrar ou ocultar senha"
                    ToolTip.Tip="Clique para mostrar ou ocultar a senha">
              <Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                    Fill="#C8D0DA"
                    Stretch="Uniform" Width="22" Height="22" />
            </Button>
          </Grid>

          <CheckBox Content="Lembrar meu e-mail" IsChecked="{Binding LembrarEmail}" AutomationProperties.Name="Lembrar meu e-mail" />

          <Button Classes="Primary" Content="Entrar" Command="{Binding EntrarCommand}" AutomationProperties.Name="Entrar" />
          <Button Classes="Ghost" Content="Criar conta" Command="{Binding CriarContaCommand}" AutomationProperties.Name="Criar conta" />
        </StackPanel>

        <!-- Indicador de carregamento -->
        <StackPanel Spacing="6" IsVisible="{Binding IsBusy}">
          <ProgressBar IsIndeterminate="True" Height="4" />
          <TextBlock Text="Autenticando..." Opacity="0.7" HorizontalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="{Binding Mensagem}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
