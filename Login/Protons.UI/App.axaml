<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Protons.UI.App"
             xmlns:local="using:Protons.UI"
             RequestedThemeVariant="Light">

  <Application.DataTemplates>
      <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Resources>
      <!-- Fonte -->
      <FontFamily x:Key="PainelFont">avares://Protons.UI/Assets/Fonts/Sora/#Sora</FontFamily>

      <!-- ── FUNDOS (hierarquia clara) ──────────────────────────────── -->
      <SolidColorBrush x:Key="BackgroundBrush"      Color="#F0F4F8" />
      <SolidColorBrush x:Key="SurfaceBrush"         Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceBorderBrush"   Color="#E2E8F0" />
      <SolidColorBrush x:Key="SurfaceHoverBrush"    Color="#F1F5F9" />
      <SolidColorBrush x:Key="SidebarBrush"         Color="#F8FAFC" />

      <!-- ── ACENTO PRIMÁRIO — TEAL DA MARCA ─────────────────────── -->
      <SolidColorBrush x:Key="AccentPrimaryBrush"   Color="#0D9488" />
      <SolidColorBrush x:Key="AccentHoverBrush"     Color="#0F766E" />
      <SolidColorBrush x:Key="AccentActiveBrush"    Color="#115E59" />

      <!-- ── ACENTOS SEMÂNTICOS ──────────────────────────────────── -->
      <SolidColorBrush x:Key="AccentTealBrush"      Color="#14B8A6" />
      <SolidColorBrush x:Key="AccentGreenBrush"     Color="#16A34A" />
      <SolidColorBrush x:Key="AccentOrangeBrush"    Color="#EA580C" />
      <SolidColorBrush x:Key="AccentRedBrush"       Color="#DC2626" />

      <!-- ── TIPOGRAFIA ─────────────────────────────────────────── -->
      <SolidColorBrush x:Key="TextPrimaryBrush"     Color="#1E293B" />
      <SolidColorBrush x:Key="TextSecondaryBrush"   Color="#64748B" />
      <SolidColorBrush x:Key="TextMutedBrush"       Color="#94A3B8" />

      <!-- ── ESPECIAIS ───────────────────────────────────────────── -->
      <SolidColorBrush x:Key="OverlayBrush"         Color="#66000000" />

      <!-- ── LEGADOS: aliases para UserControls existentes ─────── -->
      <SolidColorBrush x:Key="PanelBackground"      Color="#F0F4F8" />
      <SolidColorBrush x:Key="PanelSurface"         Color="#FFFFFF" />
      <SolidColorBrush x:Key="PanelSurfaceAlt"      Color="#F8FAFC" />
      <SolidColorBrush x:Key="PanelBorder"          Color="#E2E8F0" />
      <SolidColorBrush x:Key="PanelSidebar"         Color="#F8FAFC" />
      <SolidColorBrush x:Key="AccentBlue"           Color="#0D9488" />
      <SolidColorBrush x:Key="AccentTeal"           Color="#14B8A6" />
      <SolidColorBrush x:Key="AccentGreen"          Color="#16A34A" />
      <SolidColorBrush x:Key="AccentOrange"         Color="#EA580C" />
      <SolidColorBrush x:Key="AccentRed"            Color="#DC2626" />
      <SolidColorBrush x:Key="TextPrimary"          Color="#1E293B" />
      <SolidColorBrush x:Key="TextSecondary"        Color="#64748B" />
      <SolidColorBrush x:Key="TextMuted"            Color="#94A3B8" />

      <!-- ── MENSAGENS ──────────────────────────────────────────── -->
      <SolidColorBrush x:Key="ErrorBrush"           Color="#DC2626"/>
      <SolidColorBrush x:Key="SuccessBrush"         Color="#16A34A"/>
      <SolidColorBrush x:Key="InfoBrush"            Color="#0D9488"/>
      <SolidColorBrush x:Key="WarningBrush"         Color="#EA580C"/>
  </Application.Resources>

  <Application.Styles>
      <FluentTheme />
      <Style Selector="Window">
          <Setter Property="Background" Value="#F0F4F8"/>
          <Setter Property="TransparencyLevelHint" Value="None"/>
      </Style>
      <Style Selector="TextBlock">
          <Setter Property="Foreground" Value="#1E293B"/>
      </Style>
      <Style Selector="TextBox">
          <Setter Property="Background" Value="#FFFFFF"/>
          <Setter Property="Foreground" Value="#1E293B"/>
          <Setter Property="BorderBrush" Value="#E2E8F0"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Padding" Value="12,8"/>
          <Setter Property="FontSize" Value="14"/>
          <Setter Property="MinHeight" Value="40"/>
      </Style>
      <Style Selector="TextBox:focus">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
      </Style>
      <Style Selector="Button">
          <Setter Property="Background" Value="#FFFFFF"/>
          <Setter Property="Foreground" Value="#1E293B"/>
          <Setter Property="BorderBrush" Value="#E2E8F0"/>
          <Setter Property="BorderThickness" Value="1"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Padding" Value="12,8"/>
          <Setter Property="FontSize" Value="14"/>
          <Setter Property="MinHeight" Value="38"/>
      </Style>
      <Style Selector="Button.Primary">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
      </Style>
      <Style Selector="Button.Ghost">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="#E2E8F0"/>
      </Style>
      <Style Selector="Button.CloseButton">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="#64748B"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="CornerRadius" Value="6"/>
      </Style>
      <Style Selector="Button.CloseButton:pointerover">
          <Setter Property="Background" Value="#F1F5F9"/>
          <Setter Property="Foreground" Value="#1E293B"/>
      </Style>
      <Style Selector="Button.CloseButton:pressed">
          <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
          <Setter Property="Foreground" Value="White"/>
      </Style>
  </Application.Styles>
</Application>
