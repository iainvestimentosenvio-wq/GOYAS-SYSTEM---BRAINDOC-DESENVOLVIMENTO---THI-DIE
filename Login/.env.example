# PROJETO PROTONS - Environment Configuration Template
# Copy this file to .env and customize for your environment
# WARNING: Never commit .env to version control!

# Database Configuration
# SQLite database will be stored in user's AppData by default
# Uncomment to override for development/testing
# DB_PATH=C:\Users\YourUser\AppData\Local\Protons\Protons.db

# Audit Log Configuration
# Optional: Specify custom audit log location
# AUDIT_LOG_PATH=C:\Users\YourUser\AppData\Local\Protons\Logs\

# PBKDF2 Configuration
# Number of iterations for password hashing
# Default: 100000 (adjust based on target hardware performance)
# PBKDF2_ITERATIONS=100000

# Lockout Configuration
# Number of failed login attempts before lockout
# LOCKOUT_ATTEMPTS=5
# Lockout duration in seconds
# LOCKOUT_DURATION_SECONDS=30

# Application Settings
# APP_VERSION=1.0.0-MVP
# APP_ENVIRONMENT=Development

# Logging Configuration
# LOG_LEVEL=INFO
# ENABLE_HASH_CHAIN=true

# UI Configuration
# THEME=Dark
# REMEMBER_EMAIL=true

# Development Only - SQLite Database Path Override
# Use this to point to a test database during development
# DEV_DB_PATH=C:\Dev\Protons\TestData\Protons_Test.db

# Security Notes:
# - NEVER commit actual passwords, connection strings, or sensitive data
# - Keep .env in .gitignore
# - Document all variables here with purpose and example values
# - Use ENVIRONMENT-specific .env files (.env.development, .env.production)
