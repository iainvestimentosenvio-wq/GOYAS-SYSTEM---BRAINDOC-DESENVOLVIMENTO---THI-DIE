{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Protons (WPF)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/Protons.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Release Protons (WPF)",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build-release",
      "program": "${workspaceFolder}/bin/Release/Protons.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Attach to Protons Process",
      "type": "clr",
      "request": "attach",
      "processName": "Protons.exe"
    }
  ]
}
