<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Protons.UI.Painel.ViewModels"
             mc:Ignorable="d"
             x:Class="Protons.UI.Painel.Views.PainelPrincipal.Funcionalidades.TarefasRealizadas.PainelReguaTempoView"
             x:DataType="vm:PainelViewModel">

  <UserControl.Styles>
    <Style Selector="Button.dock-ear-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.dock-ear-toggle TextBlock">
      <Setter Property="Foreground" Value="#7B8FA4" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pointerover TextBlock">
      <Setter Property="Foreground" Value="#4B6278" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pressed TextBlock">
      <Setter Property="Foreground" Value="#41586D" />
    </Style>
  </UserControl.Styles>

  <Grid ClipToBounds="False">
    <Border Margin="24,0,0,0"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1"
            VerticalAlignment="Stretch"
            MinHeight="290"
            ClipToBounds="True"
            IsHitTestVisible="{Binding PainelEsteirasDockAberto}">
      <Border Background="Transparent"
              Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,Auto"
              RowSpacing="10">

          <!-- Cabecalho -->
          <Grid Grid.Row="0"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="8">
            <TextBlock Text="Esteiras de Tarefas"
                       FontSize="24"
                       FontWeight="SemiBold" />

            <Border Grid.Column="1"
                    Background="{DynamicResource PanelSurfaceAlt}"
                    CornerRadius="8"
                    Padding="10,6"
                    VerticalAlignment="Center">
              <TextBlock x:Name="ZoomLevelTexto"
                         Text="Zoom: --"
                         FontSize="11"
                         Foreground="{DynamicResource TextMuted}" />
            </Border>

            <Button Grid.Column="2"
                    Content="↺ Agora"
                    Command="{Binding CentralizarAgoraCommand}"
                    Padding="12,6"
                    FontSize="12"
                    Background="{DynamicResource PanelSurfaceAlt}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand" />
          </Grid>

          <!-- Esteiras (cada uma com regua do tempo interna) -->
          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="EsteirasContainer" Spacing="8">
              <!-- Populado via code-behind -->
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2"
                      Orientation="Horizontal"
                      Spacing="8">
	            <Button Content="+ Nova Esteira"
	                    Command="{Binding AdicionarEsteiraCommand}"
	                    IsEnabled="{Binding PodeUsarEsteiras}"
	                    Padding="10,6"
	                    FontSize="12"
	                    Background="{DynamicResource PanelSurface}"
                    Foreground="{DynamicResource TextMuted}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand"
                    HorizontalAlignment="Left" />
          </StackPanel>

          <Grid Grid.Row="3"
                ColumnDefinitions="*,Auto"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding ResumoTarefasCliente}"
                       FontSize="11"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Text="{Binding UltimaAtualizacaoTarefas}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMuted}" />
          </Grid>
        </Grid>
      </Border>
    </Border>

    <Border Width="32"
            Height="88"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="-4,0,0,0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            ZIndex="2">
      <Button Classes="dock-ear-toggle"
              Command="{Binding AlternarPainelEsteirasDockCommand}"
              Cursor="Hand"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ToolTip.Tip="{Binding TooltipPainelEsteirasDock}">
        <TextBlock Text="{Binding IconePainelEsteirasDock}"
                   FontSize="32"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Button>
    </Border>

    <!-- Confirmacao de remocao de esteira -->
    <Border IsVisible="{Binding ConfirmacaoRemoverEsteiraAberta}"
            Background="{DynamicResource OverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ZIndex="300">
      <Border HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="520"
              Background="{DynamicResource PanelSurfaceAlt}"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="16">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ConfirmacaoRemoverEsteiraTitulo}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />

          <TextBlock Text="{Binding ConfirmacaoRemoverEsteiraMensagem}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     FontSize="13" />

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="8">
            <Button Content="Cancelar"
                    Command="{Binding CancelarRemoverEsteiraCommand}"
                    Padding="12,6"
                    Background="{DynamicResource SurfaceHoverBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand" />

            <Button Content="Remover Esteira"
                    Command="{Binding ConfirmarRemoverEsteiraCommand}"
                    Padding="12,6"
                    Background="#DC2626"
                    Foreground="White"
                    BorderBrush="#B91C1C"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
