<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Protons.UI.Painel.ViewModels"
             mc:Ignorable="d"
             x:Class="Protons.UI.Painel.Views.PainelPrincipal.Funcionalidades.TarefasRealizadas.HistoricoExecucaoPainelPrincipalView"
             x:DataType="vm:PainelViewModel">

  <UserControl.Styles>
    <Style Selector="Button.dock-ear-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.dock-ear-toggle TextBlock">
      <Setter Property="Foreground" Value="#7B8FA4" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pointerover TextBlock">
      <Setter Property="Foreground" Value="#4B6278" />
    </Style>
    <Style Selector="Button.dock-ear-toggle:pressed TextBlock">
      <Setter Property="Foreground" Value="#41586D" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="HistoricoExecucaoTemplate" x:DataType="vm:HistoricoExecucaoItem">
      <Border BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="0,0,0,1"
              Padding="10,9"
              Cursor="Hand"
              PointerPressed="OnHistoricoItemClicked">
        <Grid ColumnDefinitions="0.75*,1.5*,2.9*,1.1*,1.1*,1.1*,0.5*" ColumnSpacing="10">
          <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="{Binding Cliente}" FontSize="13" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding Tarefa}" FontSize="13" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding Usuario}" FontSize="13" />

          <Border Grid.Column="4"
                  Background="{DynamicResource SurfaceHoverBrush}"
                  BorderBrush="{Binding CorStatus}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="8,2"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left">
            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding CorStatus}" />
          </Border>

          <TextBlock Grid.Column="5" Text="{Binding FluxoHora}" FontSize="13" />
          <TextBlock Grid.Column="6" Text="↗" FontSize="13" Classes="muted" HorizontalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="24,Auto"
        RowSpacing="0"
        ClipToBounds="False">
    <Border Grid.Row="0"
            Width="88"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,-8"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="0"
            ZIndex="2">
      <Button Classes="dock-ear-toggle"
              Command="{Binding AlternarPainelHistoricoExecucaoDockCommand}"
              Cursor="Hand"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ToolTip.Tip="{Binding TooltipPainelHistoricoExecucaoDock}">
        <TextBlock Text="{Binding IconePainelHistoricoExecucaoDock}"
                   FontSize="30"
                   FontWeight="Light"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Button>
    </Border>

    <Border x:Name="HistoricoExecucaoConteudoHost"
            Grid.Row="1"
            Height="0"
            ClipToBounds="True">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.22" />
        </Transitions>
      </Border.Transitions>

      <Border x:Name="HistoricoExecucaoConteudoCard"
              Background="{DynamicResource SurfaceBrush}"
              CornerRadius="12"
              Padding="14"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1"
              MinHeight="300"
              IsHitTestVisible="{Binding PainelHistoricoExecucaoDockAberto}">
        <StackPanel Spacing="10">
          <TextBlock Text="Historico de Execucao" FontSize="26" FontWeight="SemiBold" />

          <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
            <Button Content="Global"
                    Command="{Binding SelecionarEscopoHistoricoCommand}"
                    CommandParameter="Global"
                    Padding="12,7"
                    FontSize="12"
                    Background="{DynamicResource PanelSurfaceAlt}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand" />
            <Button Grid.Column="1"
                    Content="Cliente"
                    Command="{Binding SelecionarEscopoHistoricoCommand}"
                    CommandParameter="Cliente"
                    Padding="12,7"
                    FontSize="12"
                    Background="{DynamicResource PanelSurfaceAlt}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand" />
            <TextBlock Grid.Column="2"
                       Text="{Binding ResumoHistoricoExecucao}"
                       FontSize="11"
                       Classes="muted"
                       VerticalAlignment="Center" />
            <Button Grid.Column="3"
                    Content="Ver todas"
                    Command="{Binding VerTodasExecucoesCommand}"
                    Padding="16,8"
                    FontSize="14"
                    Background="{DynamicResource PanelSurfaceAlt}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Cursor="Hand" />
          </Grid>

          <Border Background="{DynamicResource PanelSurfaceAlt}"
                  BorderBrush="{DynamicResource PanelBorder}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10,8">
            <Grid ColumnDefinitions="0.75*,1.5*,2.9*,1.1*,1.1*,1.1*,0.5*" ColumnSpacing="10">
              <TextBlock Text="ID" FontSize="11" Classes="muted" />
              <TextBlock Grid.Column="1" Text="Cliente" FontSize="11" Classes="muted" />
              <TextBlock Grid.Column="2" Text="Tarefa" FontSize="11" Classes="muted" />
              <TextBlock Grid.Column="3" Text="Usuario" FontSize="11" Classes="muted" />
              <TextBlock Grid.Column="4" Text="Status" FontSize="11" Classes="muted" />
              <TextBlock Grid.Column="5" Text="Data/Hora" FontSize="11" Classes="muted" />
              <TextBlock Grid.Column="6" Text="Abrir" FontSize="11" Classes="muted" />
            </Grid>
          </Border>

          <Border Background="{DynamicResource BackgroundBrush}"
                  BorderBrush="{DynamicResource PanelBorder}"
                  BorderThickness="1"
                  CornerRadius="8">
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding HistoricoExecucao}" ItemTemplate="{StaticResource HistoricoExecucaoTemplate}" />
                <Button Content="Carregar mais"
                        Command="{Binding CarregarMaisHistoricoCommand}"
                        IsVisible="{Binding TemMaisHistorico}"
                        Padding="16,8"
                        FontSize="12"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource PanelSurfaceAlt}"
                        BorderBrush="{DynamicResource PanelBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Cursor="Hand" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
