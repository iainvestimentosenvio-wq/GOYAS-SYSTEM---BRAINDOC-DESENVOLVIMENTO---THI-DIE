<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Protons.UI.Painel.ViewModels"
             mc:Ignorable="d"
             x:Class="Protons.UI.Painel.Views.PainelPrincipal.Funcionalidades.TarefasRealizadas.TarefasRealizadasPainelPrincipalView"
             x:DataType="vm:PainelViewModel">

  <UserControl.Resources>
    <DataTemplate x:Key="TimelineCardTemplate" x:DataType="vm:TarefaTimelineItem">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Background="#111A2A"
                BorderBrush="{Binding CorStatus}"
                BorderThickness="0,0,0,2"
                CornerRadius="10"
                Padding="10"
                MinWidth="270"
                MaxWidth="270">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock Text="{Binding Titulo}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Text="{Binding StatusTexto}"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{Binding CorStatus}" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding HorarioTexto}" FontSize="28" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="{Binding Responsavel}" FontSize="12" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="2" Background="#3D2E0F" CornerRadius="7" Padding="6,2" IsVisible="{Binding TemGap}">
                <TextBlock Text="{Binding BadgeTempo}" FontSize="10" Foreground="{DynamicResource AccentOrange}" FontWeight="Bold" />
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Acompanhamento da esteira" FontSize="11" Classes="muted" />
              <Button Grid.Column="1"
                      Content="Rearmar"
                      Padding="8,3"
                      FontSize="11"
                      Background="#313A4B"
                      Foreground="White"
                      BorderThickness="0"
                      CornerRadius="6"
                      Cursor="Hand"
                      IsVisible="{Binding Cancelada}" />
            </Grid>
          </StackPanel>
        </Border>

        <Grid IsVisible="{Binding TemConexao}" Width="42" VerticalAlignment="Center">
          <Border Height="2" Background="#5C6F88" VerticalAlignment="Center" />
          <Border Width="8" Height="8" CornerRadius="4" Background="#5C6F88" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Border Background="#0F1728"
          CornerRadius="12"
          Padding="14"
          BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1"
          MinHeight="290">
    <StackPanel Spacing="10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Text="Esteira de Tarefas" FontSize="35" FontWeight="SemiBold" />
        <Button Grid.Column="1"
                Content="{Binding TextoBotaoExpandirTimeline}"
                Command="{Binding AlternarExpandirTimelineCommand}"
                Padding="14,7"
                FontSize="13"
                Background="#162238"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Cursor="Hand" />
      </Grid>

      <Border Background="#111D2F"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="8,6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Pendencias Futuras"
                  Command="{Binding SelecionarCategoriaTimelineCommand}"
                  CommandParameter="Futuras"
                  Padding="12,6"
                  FontSize="13"
                  Background="#202B44"
                  BorderThickness="0"
                  CornerRadius="7"
                  Cursor="Hand" />
          <Button Content="Pendencias Atrasadas"
                  Command="{Binding SelecionarCategoriaTimelineCommand}"
                  CommandParameter="Atrasadas"
                  Padding="12,6"
                  FontSize="13"
                  Background="Transparent"
                  BorderThickness="0"
                  CornerRadius="7"
                  Foreground="{DynamicResource TextSecondary}"
                  Cursor="Hand" />
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="6,0,0,0">
            <Button Content="Realizadas"
                    Command="{Binding SelecionarCategoriaTimelineCommand}"
                    CommandParameter="Realizadas"
                    Padding="12,6"
                    FontSize="13"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="7"
                    Foreground="{DynamicResource TextSecondary}"
                    Cursor="Hand" />
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource AccentGreen}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="#4A2C12"
              BorderBrush="{DynamicResource AccentOrange}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10,7"
              IsVisible="{Binding TemAlertaGapCurto}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="!" FontSize="14" />
          <TextBlock Text="{Binding AlertaGapCurtoTexto}" FontSize="12" Foreground="#FFD89A" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <Border Background="#0C1320"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12,12,12,8">
        <Grid ColumnDefinitions="22,*" ColumnSpacing="8" MinHeight="170">
          <Grid>
            <Border Width="2" Background="#243349" HorizontalAlignment="Center" Margin="0,6,0,10" />
            <Border Width="16" Height="16" Background="#17C68C" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Grid.Column="1" Spacing="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding TimelineExibida}" ItemTemplate="{StaticResource TimelineCardTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>

            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Text="{Binding MensagemTarefasCliente}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="1" Background="#152238" CornerRadius="8" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="# tow Criticos" FontSize="10" Classes="muted" />
                  <Border Width="10" Height="10" Background="#17C68C" CornerRadius="5" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
