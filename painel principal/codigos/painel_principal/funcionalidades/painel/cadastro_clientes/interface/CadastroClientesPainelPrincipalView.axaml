<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Protons.UI.Painel.ViewModels"
             mc:Ignorable="d"
             x:Class="Protons.UI.Painel.Views.PainelPrincipal.Funcionalidades.CadastroClientes.CadastroClientesPainelPrincipalView"
             x:DataType="vm:PainelViewModel"
             KeyDown="OnCadastroRootKeyDown">

  <Border Background="{DynamicResource SurfaceBrush}"
          CornerRadius="16"
          BorderBrush="{DynamicResource PanelBorder}"
          BorderThickness="1"
          Padding="0">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Background="{DynamicResource PanelSurfaceAlt}"
              BorderBrush="{DynamicResource PanelBorder}"
              BorderThickness="0,0,0,1"
              CornerRadius="16,16,0,0"
              Padding="24,20,24,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Cadastro de Clientes" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Cadastre clientes com CPF ou CNPJ para uso nas próximas funcionalidades."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="Dica: use a busca do topo para filtrar por grupo, fantasia, razao social, codigo ou documento."
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}" />
          </StackPanel>

          <Button Grid.Column="1"
                  Classes="btn-secondary"
                  Content="Fechar"
                  Command="{Binding FecharCadastroClientesCommand}"
                  Padding="14,8" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,18,24,24">
          <!-- Banner informativo -->
          <Border Background="#EFF6FF"
                  BorderBrush="#93C5FD"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Status cadastral atual: sem integração automática oficial da Serpro nesta versão."
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="#1E40AF" />
              <TextBlock Text="Conferência humana dos dados cadastrais é obrigatória antes de usar automações críticas."
                         FontSize="11"
                         Foreground="#3B82F6"
                         TextWrapping="Wrap" />
              <TextBlock Text="Roadmap: modo gratuito assistido agora; integração oficial por API paga em fase futura."
                         FontSize="11"
                         Foreground="#3B82F6"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Formulário de dados -->
          <Border Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource PanelBorder}"
                  BorderThickness="1"
                  Padding="14">
            <StackPanel Spacing="12">
              <TextBlock Text="Dados do cliente" FontSize="13" FontWeight="SemiBold" />
              <TextBlock IsVisible="{Binding ModoEdicaoClienteCadastro}"
                         Text="Modo edição ativo: documento bloqueado para evitar inconsistência."
                         FontSize="11"
                         Foreground="{DynamicResource AccentOrange}" />

              <Grid ColumnDefinitions="1.1*,1.4*,1.3*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6">
                  <TextBlock Text="Código do Cliente" FontSize="12" FontWeight="SemiBold" />
                  <TextBox x:Name="CodigoClienteCadastroTextBox"
                           Text="{Binding ClienteCodigoCadastro}"
                           Watermark="Ex.: CLI-000123"
                           TabIndex="1"
                           KeyDown="OnCadastroCampoKeyDown"
                           BorderBrush="{Binding CorBordaCodigoClienteCadastro}"
                           BorderThickness="1" />
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="6">
                  <TextBlock Text="Nome do Cliente" FontSize="12" FontWeight="SemiBold" />
                  <TextBox x:Name="NomeClienteCadastroTextBox"
                           Text="{Binding ClienteNomeCadastro}"
                           Watermark="Ex.: Empresa Exemplo LTDA"
                           TabIndex="2"
                           KeyDown="OnCadastroCampoKeyDown"
                           BorderBrush="{Binding CorBordaNomeClienteCadastro}"
                           BorderThickness="1" />
                </StackPanel>

                <StackPanel Grid.Column="2" Grid.Row="0" Spacing="6">
                  <TextBlock Text="Nome Fantasia (opcional)" FontSize="12" FontWeight="SemiBold" />
                  <TextBox x:Name="NomeFantasiaClienteCadastroTextBox"
                           Text="{Binding ClienteNomeFantasiaCadastro}"
                           Watermark="Ex.: Exemplo Contábil"
                           TabIndex="3"
                           KeyDown="OnCadastroCampoKeyDown"
                           BorderBrush="{Binding CorBordaNomeFantasiaCadastro}"
                           BorderThickness="1" />
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Spacing="6">
                  <TextBlock Text="Documento" FontSize="12" FontWeight="SemiBold" />
                  <TextBox x:Name="DocumentoClienteCadastroTextBox"
                           Text="{Binding ClienteDocumentoCadastro}"
                           Watermark="CPF ou CNPJ (somente números ou com máscara)"
                           MaxLength="18"
                           IsReadOnly="{Binding DocumentoCadastroSomenteLeitura}"
                           TabIndex="4"
                           KeyDown="OnCadastroCampoKeyDown"
                           BorderBrush="{Binding CorBordaDocumentoCadastro}"
                           BorderThickness="1" />
                  <TextBlock Text="{Binding ClienteDocumentoStatusCadastro}"
                             FontSize="11"
                             Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Spacing="6">
                  <TextBlock Text="Grupo Empresarial (opcional)" FontSize="12" FontWeight="SemiBold" />
                  <ComboBox x:Name="GrupoEmpresarialCadastroComboBox"
                            ItemsSource="{Binding GruposEmpresariaisDisponiveis}"
                            SelectedItem="{Binding GrupoEmpresarialSelecionadoCadastro}"
                            TabIndex="5"
                            KeyDown="OnCadastroCampoKeyDown"
                            BorderBrush="{Binding CorBordaGrupoCadastro}"
                            BorderThickness="1">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GrupoEmpresarialPainel">
                        <TextBlock Text="{Binding Nome}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="btn-secondary"
                            Content="Cadastrar Grupo"
                            Command="{Binding AbrirCadastroGrupoCommand}"
                            Padding="10,6" />
                    <Button Classes="btn-secondary"
                            Content="Limpar"
                            Command="{Binding LimparGrupoSelecionadoCommand}"
                            Padding="10,6" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="2" Spacing="6">
                  <TextBlock Text="E-mail (opcional)" FontSize="12" FontWeight="SemiBold" />
                  <TextBox x:Name="EmailClienteCadastroTextBox"
                           Text="{Binding ClienteEmailCadastro}"
                           Watermark="cliente@empresa.com"
                           TabIndex="6"
                           KeyDown="OnCadastroCampoKeyDown"
                           BorderBrush="{Binding CorBordaEmailCadastro}"
                           BorderThickness="1" />
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="2" Spacing="6">
                  <TextBlock Text="Telefone (opcional)" FontSize="12" FontWeight="SemiBold" />
                  <TextBox x:Name="TelefoneClienteCadastroTextBox"
                           Text="{Binding ClienteTelefoneCadastro}"
                           Watermark="(00) 00000-0000"
                           TabIndex="7"
                           KeyDown="OnCadastroCampoKeyDown"
                           BorderBrush="{Binding CorBordaTelefoneCadastro}"
                           BorderThickness="1" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Cadastro de grupo (expandível) -->
          <Border IsVisible="{Binding CadastroGrupoAberto}"
                  Background="{DynamicResource PanelSurfaceAlt}"
                  CornerRadius="10"
                  BorderBrush="{DynamicResource PanelBorder}"
                  BorderThickness="1"
                  Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Cadastrar Grupo Empresarial" FontSize="13" FontWeight="SemiBold" />
              <TextBox Text="{Binding GrupoEmpresarialCadastroNome}"
                       Watermark="Nome do grupo" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="btn-primary"
                        Content="Salvar Grupo"
                        Command="{Binding SalvarGrupoEmpresarialCommand}"
                        Padding="12,8" />
                <Button Classes="btn-secondary"
                        Content="Cancelar"
                        Command="{Binding FecharCadastroGrupoCommand}"
                        Padding="12,8" />
              </StackPanel>
              <TextBlock Text="{Binding MensagemCadastroGrupo}"
                         FontSize="11"
                         Foreground="{DynamicResource AccentOrange}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Botões de ação -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="btn-primary"
                    Content="{Binding RotuloBotaoSalvarCliente}"
                    Command="{Binding SalvarClienteCommand}"
                    x:Name="SalvarClienteCadastroButton"
                    TabIndex="8"
                    KeyDown="OnSalvarClienteButtonKeyDown"
                    Padding="18,10" />
            <Button Classes="btn-danger"
                    Content="Inativar Cliente"
                    Command="{Binding SolicitarInativarClienteCommand}"
                    IsVisible="{Binding ExibirAcoesEdicaoCliente}"
                    Padding="18,10" />
          </StackPanel>

          <!-- Banner de resultado -->
          <Border IsVisible="{Binding ExibirBannerCadastroCliente}"
                  Background="{Binding CorFundoMensagemCadastroCliente}"
                  BorderBrush="{Binding CorBordaMensagemCadastroCliente}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,10">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding MensagemCadastroCliente}"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{Binding CorTextoMensagemCadastroCliente}"
                         TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding ExibirReferenciaErroCadastro}"
                         Text="{Binding ReferenciaErroCadastro, StringFormat=Referência: {0}}"
                         FontSize="11"
                         Foreground="{Binding CorTextoMensagemCadastroCliente}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Lista de clientes cadastrados -->
          <Border Background="{DynamicResource SurfaceBrush}"
                  CornerRadius="10"
                  Padding="14"
                  BorderBrush="{DynamicResource PanelBorder}"
                  BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="Clientes Cadastrados" FontSize="14" FontWeight="SemiBold" />
              <TextBox Text="{Binding BuscaListaClientesCadastro}"
                       Watermark="Buscar na lista: código, nome, fantasia, grupo ou documento..." />
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding ResumoBuscaClientes}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="btn-secondary"
                        Content="Anterior"
                        Command="{Binding PaginaAnteriorClientesCommand}"
                        TabIndex="9"
                        Margin="0,0,8,0"
                        Padding="10,6" />
                <Button Grid.Column="2"
                        Classes="btn-secondary"
                        Content="Próxima"
                        Command="{Binding ProximaPaginaClientesCommand}"
                        TabIndex="10"
                        Padding="10,6" />
              </Grid>

              <!-- Cabeçalho da tabela -->
              <Border Background="{DynamicResource PanelSurfaceAlt}"
                      CornerRadius="6"
                      Padding="10,8"
                      BorderBrush="{DynamicResource PanelBorder}"
                      BorderThickness="1">
                <Grid ColumnDefinitions="1.0*,1.6*,1.4*,0.7*,1.1*,1.0*" ColumnSpacing="8">
                  <TextBlock Text="Código" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="1" Text="Nome" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="2" Text="Fantasia / Grupo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="3" Text="Tipo" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="4" Text="Documento" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                  <TextBlock Grid.Column="5" Text="Ações" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                </Grid>
              </Border>

              <!-- Itens da lista -->
              <ListBox MaxHeight="220"
                       ItemsSource="{Binding ClientesCadastrados}"
                       SelectedItem="{Binding ClienteSelecionadoNaListaCadastro}"
                       Background="Transparent"
                       BorderThickness="0"
                       HorizontalAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ClienteResumoPainel">
                    <Border Padding="10,8"
                            Margin="0,0,0,4"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="1">
                      <Grid ColumnDefinitions="1.0*,1.6*,1.4*,0.7*,1.1*,1.0*" ColumnSpacing="8">
                        <TextBlock Text="{Binding CodigoCliente}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Spacing="1">
                          <TextBlock Text="{Binding NomeFantasia}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding GrupoEmpresarialNome}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding TipoDocumento}" FontSize="12" />
                        <TextBlock Grid.Column="4" Text="{Binding Documento}" FontSize="12" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6">
                          <Button Content="Abrir"
                                  Classes="btn-secondary"
                                  Padding="8,4"
                                  Command="{Binding $parent[UserControl].((vm:PainelViewModel)DataContext).AbrirClienteListaCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Content="Inativar"
                                  Classes="btn-danger"
                                  Padding="8,4"
                                  Command="{Binding $parent[UserControl].((vm:PainelViewModel)DataContext).SolicitarInativarClienteCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Carregando clientes..."
                         IsVisible="{Binding CarregandoClientes}"
                         FontSize="11"
                         Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Modal: confirmar cadastro -->
      <Border Grid.RowSpan="2"
              IsVisible="{Binding ExibirConfirmacaoSalvarCadastro}"
              Background="{DynamicResource OverlayBrush}"
              ZIndex="30">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                BoxShadow="0 8 32 0 #1A000000">
          <StackPanel Spacing="12">
            <TextBlock Text="Confirmar cadastro"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ResumoConfirmacaoSalvarCadastro}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button Content="Cancelar"
                      Classes="btn-secondary"
                      Command="{Binding CancelarSalvarClienteCommand}"
                      Padding="12,8" />
              <Button x:Name="ConfirmarSalvarCadastroButton"
                      Content="Confirmar"
                      Classes="btn-primary"
                      Command="{Binding ConfirmarSalvarClienteCommand}"
                      Padding="12,8" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>

      <!-- Modal: confirmar inativação -->
      <Border Grid.RowSpan="2"
              IsVisible="{Binding ExibirConfirmacaoInativarCliente}"
              Background="{DynamicResource OverlayBrush}"
              ZIndex="31">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="520"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource AccentRedBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                BoxShadow="0 8 32 0 #1A000000">
          <StackPanel Spacing="12">
            <TextBlock Text="Confirmar inativação"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding ResumoConfirmacaoInativarCliente}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button Content="Cancelar"
                      Classes="btn-secondary"
                      Command="{Binding CancelarInativarClienteCommand}"
                      Padding="12,8" />
              <Button Content="Inativar"
                      Classes="btn-danger"
                      Command="{Binding ConfirmarInativarClienteCommand}"
                      Padding="12,8" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</UserControl>
