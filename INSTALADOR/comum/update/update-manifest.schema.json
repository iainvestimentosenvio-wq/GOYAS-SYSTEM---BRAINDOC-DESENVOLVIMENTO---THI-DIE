{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protons.local/schemas/update-manifest.schema.json",
  "title": "Protons Update Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "channel",
    "published_at_utc",
    "min_supported_version",
    "artifacts",
    "release_notes_url",
    "rollout_percent"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["stable", "beta"]
    },
    "published_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "min_supported_version": {
      "type": "string",
      "minLength": 1
    },
    "release_notes_url": {
      "type": "string",
      "pattern": "^(https://|file://).+"
    },
    "rollout_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "type",
          "url",
          "sha256",
          "size_bytes",
          "signature"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "enum": ["windows", "linux"]
          },
          "type": {
            "type": "string",
            "enum": ["msi", "exe", "deb", "appimage"]
          },
          "url": {
            "type": "string",
            "pattern": "^(https://|file://).+"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "signature": {
            "oneOf": [
              { "const": "UNSIGNED" },
              {
                "type": "string",
                "pattern": "^(https://|file://).+"
              }
            ]
          }
        }
      }
    }
  }
}
